# Copie ce fichier en .env (jamais commité) ou renseigne ces variables chez ton hébergeur.

NODE_ENV=production
APP_URL=https://www.ton-domaine.fr        # adresse publique du site (liens dans les e-mails, retours Stripe)
SESSION_SECRET=une-longue-chaine-aleatoire # ex. : node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
DATA_DIR=/var/data/relais                  # disque persistant : base de données + fichiers envoyés

# Paiements (Stripe Connect) – https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...

# E-mails (SMTP) – ex. Brevo : smtp-relay.brevo.com, port 587
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=...
SMTP_PASS=...
MAIL_FROM=Relais <contact@ton-domaine.fr>
