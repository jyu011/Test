<%- include('partials/header') %>
<section class="wrap section-tight narrow-wide">
  <a href="/messages/<%= b.conversation_id %>" class="back-link">← Retour à la conversation</a>
  <div class="booking-head">
    <h1 class="page-title">Cours de <%= b.subject %></h1>
    <span class="status status-<%= b.status %>"><%= b.statusLabel %></span>
  </div>

  <div class="card booking-card">
    <ul class="facts facts-row">
      <li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><rect x="3" y="5" width="18" height="16" rx="2"></rect><path d="M3 10h18M8 3v4M16 3v4"></path></svg><div><b>Quand</b><br><%= b.when %> (<%= b.duration %>)</div></li>
      <li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="12" cy="8" r="4"></circle><path d="M4 21c0-4 4-6 8-6s8 2 8 6"></path></svg><div><b><%= b.isStudent ? 'Prof' : 'Élève' %></b><br><%= b.otherName %></div></li>
      <li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><rect x="3" y="4" width="18" height="14" rx="2"></rect><path d="M8 21h8"></path></svg><div><b>Format</b><br><%= b.modeLabel %></div></li>
    </ul>
    <% if (b.note) { %><p class="booking-note"><b>Message :</b> <%= b.note %></p><% } %>

    <div class="price-box">
      <div><span class="muted">Prix</span><b><%= b.price %></b><small class="muted"><%= b.hourly_rate %> € / h</small></div>
      <ul class="price-split">
        <li>Frais de service Relais (30 %) : <%= b.commission %></li>
        <li>Pour le prof (70 %) : <b><%= b.tutorAmount %></b><% if (b.status === 'terminee') { %> – <%= b.payout_status === 'verse' ? 'versé' : 'versement en attente' %><% } %></li>
      </ul>
    </div>

    <ol class="timeline">
      <li class="<%= b.status !== 'proposee' ? 'done' : 'current' %>"><b>Créneau validé par les deux</b><span>
        <% if (b.status === 'proposee') { %><%= b.proposed_by === user.id ? 'En attente de la réponse de ' + b.otherName : b.otherName + ' propose ce créneau : à toi de répondre' %><% } else { %>Confirmé<% } %></span></li>
      <li class="<%= ['payee', 'terminee', 'litige'].includes(b.status) ? 'done' : (b.status === 'confirmee' ? 'current' : '') %>"><b>Paiement par carte sur Relais</b><span>
        <%= ['payee', 'terminee', 'litige'].includes(b.status) ? 'Payé – l\'argent est conservé par Relais jusqu\'à la fin du cours' : (b.isStudent ? 'À régler pour réserver définitivement le cours' : 'En attente du paiement de l\'élève') %></span></li>
      <li class="<%= b.status === 'terminee' ? 'done' : (b.status === 'payee' && b.past ? 'current' : '') %>"><b>Validation par l'élève après le cours</b><span>
        <%= b.status === 'terminee' ? 'Validé' + (b.validated_by === 'auto' ? ' automatiquement' : '') : 'L\'élève confirme que le cours s\'est bien passé (validation automatique après 72 h)' %></span></li>
      <li class="<%= b.payout_status === 'verse' ? 'done' : '' %>"><b>Versement au prof</b><span><%= b.payout_status === 'verse' ? b.tutorAmount + ' versés sur son compte bancaire' : b.tutorAmount + ' versés automatiquement après validation' %></span></li>
    </ol>

    <% if (['refusee', 'annulee', 'remboursee', 'expiree'].includes(b.status)) { %>
      <p class="muted"><%= b.status === 'remboursee' ? 'Le paiement a été intégralement remboursé.' : (b.status === 'expiree' ? "Ce créneau n'a pas été confirmé ou payé à temps." : 'Ce cours n\'aura pas lieu.') %><% if (b.cancel_reason) { %> Motif : <%= b.cancel_reason %><% } %></p>
    <% } %>
    <% if (b.status === 'litige') { %>
      <div class="flash flash-info">Problème signalé : « <%= b.issue_text %> ». Le paiement est bloqué ; l'équipe Relais vous recontacte par e-mail.</div>
    <% } %>

    <%- include('partials/booking-actions', { b }) %>

    <% if (b.can.report) { %>
      <details class="sub-action">
        <summary>Le cours ne s'est pas bien passé ?</summary>
        <form method="post" action="/reservations/<%= b.id %>/probleme">
          <input type="hidden" name="_csrf" value="<%= csrf %>">
          <label class="field"><span>Explique ce qui s'est passé</span><textarea name="issue" rows="3" minlength="10" maxlength="1000" required placeholder="Ex. : le prof n'est pas venu, cours écourté…"></textarea></label>
          <button class="btn btn-danger">Signaler un problème</button>
        </form>
      </details>
    <% } %>
    <% if (b.can.cancel || b.can.withdraw) { %>
      <details class="sub-action">
        <summary><%= b.can.withdraw ? 'Retirer ma proposition' : 'Annuler ce cours' %></summary>
        <form method="post" action="/reservations/<%= b.id %>/annuler" data-confirm="Confirmer l'annulation ?">
          <input type="hidden" name="_csrf" value="<%= csrf %>">
          <% if (b.status === 'payee') { %><p class="muted small">Annulation à plus de 24 h du cours : l'élève est intégralement remboursé.</p><% } %>
          <label class="field"><span>Motif <em>(facultatif)</em></span><input name="reason" maxlength="300"></label>
          <button class="btn btn-ghost">Confirmer l'annulation</button>
        </form>
      </details>
    <% } %>
    <% if (b.can.lateCancel) { %>
      <p class="muted small">Moins de 24 h avant le cours : l'annulation n'est plus possible en ligne. En cas d'empêchement, préviens l'autre personne via la messagerie<%= b.isStudent ? " et, si le cours n'a pas lieu, signale-le après l'heure prévue" : '' %>.</p>
    <% } %>
  </div>
  <p class="secure-note"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><rect x="5" y="11" width="14" height="10" rx="2"></rect><path d="M8 11V7a4 4 0 0 1 8 0v4"></path></svg>Paiement par carte sécurisé (3D Secure) par notre prestataire Stripe. Relais n'a jamais accès à tes données de carte ni au RIB des profs.</p>
</section>
<%- include('partials/footer') %>
