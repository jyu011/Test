<!doctype html>
<html lang="fr">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title><%= title ? title + ' · Relais' : 'Relais – Des étudiants qui donnent des cours particuliers' %></title>
<meta name="description" content="Relais met en relation élèves et étudiants qui donnent des cours particuliers, du primaire au lycée.">
<link rel="icon" href="/static/img/logo.svg" type="image/svg+xml">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:wght@500;700;800&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
<link rel="stylesheet" href="/static/css/style.css">
<script src="/static/js/app.js" defer></script>
</head>
<body>
<a class="skip" href="#contenu">Aller au contenu</a>
<header class="site-header">
  <div class="wrap header-inner">
    <a href="/" class="brand" aria-label="Relais, accueil">
      <%- include('logo') %>
      <span class="brand-name">relais<span class="dot">.</span></span>
    </a>
    <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="menu" aria-label="Ouvrir le menu">
      <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16"></path></svg>
    </button>
    <nav id="menu" class="main-nav" aria-label="Menu principal">
      <a href="/" class="<%= path === '/' ? 'active' : '' %>">Accueil</a>
      <a href="/profs" class="<%= path.startsWith('/profs') ? 'active' : '' %>">Trouver un prof</a>
      <a href="/#comment">Comment ça marche</a>
      <a href="/devenir-prof" class="<%= path === '/devenir-prof' || path === '/inscription/prof' ? 'active' : '' %>">Donner des cours</a>
      <% if (user) { %>
        <a href="/messages" class="nav-messages <%= path.startsWith('/messages') ? 'active' : '' %>">Messages<% if (unread) { %> <span class="badge-count" aria-label="<%= unread %> non lus"><%= unread %></span><% } %></a>
      <% } %>
      <a href="/compte" class="btn btn-primary btn-account">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="12" cy="8" r="4"></circle><path d="M4 21c0-4 4-6 8-6s8 2 8 6"></path></svg>
        <%= user ? (user.role === 'admin' ? 'Admin' : user.first_name) : 'Mon compte' %>
      </a>
    </nav>
  </div>
</header>
<main id="contenu">
<% if (flash) { %>
  <div class="wrap"><div class="flash flash-<%= flash.type %>" role="status"><%= flash.text %></div></div>
<% } %>
