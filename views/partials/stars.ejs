<% const r = Number(rating) || 0; const half = Math.round(r * 2) / 2; %>
<span class="stars" role="img" aria-label="<%= r ? String(r).replace('.', ',') + ' sur 5' : 'Pas encore noté' %>">
  <% for (let i = 1; i <= 5; i++) { const cls = half >= i ? 'full' : (half >= i - 0.5 ? 'half' : 'empty'); %>
    <svg viewBox="0 0 24 24" class="star star-<%= cls %>" aria-hidden="true"><path class="star-bg" d="M12 2.5l2.9 6 6.6.8-4.9 4.5 1.3 6.5L12 17l-5.9 3.3 1.3-6.5L2.5 9.3l6.6-.8z"></path><% if (cls === 'half') { %><path class="star-fg" d="M12 2.5L9.1 8.5L2.5 9.3L7.4 13.8L6.1 20.3L12 17Z"></path><% } %></svg>
  <% } %>
</span>
