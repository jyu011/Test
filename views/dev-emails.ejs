<%- include('partials/header') %>
<section class="wrap section-tight">
  <h1 class="page-title">E-mails envoyés (développement)</h1>
  <p class="lead">Aucun serveur SMTP n'est configuré : les e-mails sont enregistrés ici au lieu d'être envoyés. Cette page n'existe pas en production.</p>
  <div class="table-wrap card">
    <table class="table">
      <thead><tr><th>Date</th><th>Destinataire</th><th>Objet</th></tr></thead>
      <tbody>
        <% items.forEach(function (e) { %>
          <tr><td><%= e.at.toLocaleString('fr-FR', { timeZone: 'Europe/Paris' }) %></td><td><%= e.to %></td><td><a href="/dev/emails/<%= e.file %>" target="_blank" rel="noopener"><%= e.subject %></a></td></tr>
        <% }) %>
      </tbody>
    </table>
  </div>
</section>
<%- include('partials/footer') %>
