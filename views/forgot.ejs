<%- include('partials/header') %>
<section class="wrap section-tight narrow">
  <div class="card form-card">
    <h1 class="page-title">Mot de passe oublié</h1>
    <% if (sent) { %>
      <div class="flash flash-success" role="status">Si un compte existe avec cette adresse, un e-mail avec un lien de réinitialisation vient d'être envoyé (valable 1 heure). Pense à vérifier tes spams.</div>
      <a href="/connexion" class="btn btn-primary">Retour à la connexion</a>
    <% } else { %>
      <p class="muted">Indique l'adresse e-mail de ton compte : nous t'enverrons un lien pour choisir un nouveau mot de passe.</p>
      <form method="post" action="/mot-de-passe-oublie">
        <input type="hidden" name="_csrf" value="<%= csrf %>">
        <label class="field"><span>Adresse e-mail</span><input type="email" name="email" required autocomplete="email" autofocus></label>
        <button class="btn btn-primary btn-block">Envoyer le lien</button>
      </form>
    <% } %>
  </div>
</section>
<%- include('partials/footer') %>
