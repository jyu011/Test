<%- include('partials/header') %>
<section class="wrap section-tight">
  <h1 class="page-title">Messagerie</h1>
  <div class="inbox <%= current ? 'has-current' : '' %>">
    <nav class="inbox-list card" aria-label="Conversations">
      <% if (!conversations.length) { %>
        <div class="empty-small">
          <p>Aucune conversation pour l'instant.</p>
          <% if (user.role === 'eleve') { %><a href="/profs" class="btn btn-coral">Trouver un prof</a><% } else { %><p class="muted small">Les élèves intéressés t'écriront ici.</p><% } %>
        </div>
      <% } %>
      <% conversations.forEach(function (c) { %>
        <a href="/messages/<%= c.id %>" class="conv <%= current && current.id === c.id ? 'active' : '' %>">
          <%- include('partials/avatar', { photo: c.otherPhoto, initial: c.otherInitial, size: 'sm' }) %>
          <span class="conv-body">
            <span class="conv-name"><%= c.otherName %><% if (c.unread) { %> <span class="badge-count"><%= c.unread %></span><% } %></span>
            <span class="conv-last"><%= c.last_body || '' %></span>
          </span>
          <span class="conv-date"><%= c.last_at ? frDateTime(c.last_at) : '' %></span>
        </a>
      <% }) %>
    </nav>

    <% if (current) { %>
      <div class="thread card">
        <div class="thread-head">
          <a href="/messages" class="back-link thread-back">←</a>
          <%- include('partials/avatar', { photo: other.photo, initial: other.initial, size: 'md' }) %>
          <div>
            <b><% if (other.link) { %><a href="<%= other.link %>"><%= other.name %></a><% } else { %><%= other.name %><% } %></b>
            <div class="muted small"><%= other.sub %></div>
          </div>
        </div>
        <div class="thread-messages" id="thread" data-conv="<%= current.id %>" data-last="<%= messages.length ? messages[messages.length - 1].id : 0 %>" aria-live="polite">
          <% messages.forEach(function (m) { %>
            <div class="msg <%= m.mine ? 'msg-mine' : '' %>" data-id="<%= m.id %>"><p><%= m.body %></p><time><%= m.at %></time></div>
          <% }) %>
          <span id="bas"></span>
        </div>
        <form class="thread-form" method="post" action="/messages/<%= current.id %>" id="send-form">
          <input type="hidden" name="_csrf" value="<%= csrf %>">
          <label for="msg-body" class="sr-only">Ton message</label>
          <textarea id="msg-body" name="body" rows="2" maxlength="2000" required placeholder="Écris ton message…"></textarea>
          <button class="btn btn-primary" type="submit">Envoyer</button>
        </form>
        <p class="secure-note">Pour ta sécurité, garde les échanges sur Relais jusqu'au premier cours et ne partage jamais de mot de passe ou de coordonnées bancaires.</p>
      </div>

      <% if (student) { %>
        <aside class="student-card card" aria-label="Fiche de l'élève">
          <h2 class="card-title">Fiche élève</h2>
          <div class="student-id">
            <%- include('partials/avatar', { photo: null, initial: student.first_name.charAt(0), size: 'lg' }) %>
            <div>
              <b><%= student.account_type === 'parent' ? student.child_first_name : student.first_name %></b>
              <div class="muted small"><%= student.account_type === 'parent' ? 'Compte géré par un parent (' + publicName(student) + ')' : publicName(student) %></div>
            </div>
          </div>
          <dl class="info-list">
            <dt>Classe</dt><dd><%= student.school_grade %></dd>
            <dt>Ville</dt><dd><%= student.city %> (<%= student.postal_code.slice(0, 2) %>)</dd>
            <% if (student.subjectList.length) { %><dt>Matières</dt><dd><div class="chips"><% student.subjectList.forEach(function (s) { %><span class="chip"><%= s %></span><% }) %></div></dd><% } %>
            <% if (student.goals) { %><dt>Objectifs</dt><dd><%= student.goals %></dd><% } %>
            <dt>Membre depuis</dt><dd><%= frDate(student.created_at) %></dd>
          </dl>
        </aside>
      <% } %>
    <% } else { %>
      <div class="thread card thread-empty"><p class="muted">Choisis une conversation à gauche.</p></div>
    <% } %>
  </div>
</section>
<script src="/static/js/messages.js" defer></script>
<%- include('partials/footer') %>
